{
  "asyncapi": "2.6.0",
  "info": {
    "title": "YIXIN Mobile Trade Streaming API",
    "version": "1.0.23",
    "description": "AsyncAPI spec for Centrifugo/WebSocket streams used by the Flutter mobile app. Derived from lib/services/streaming_service.dart and tenant.json. The client subscribes to channels and receives UTF-8 JSON publications."
  },
  "servers": {
    "centrifugoWebSocket": {
      "url": "streaming.verolabs.co/connection/websocket",
      "protocol": "wss",
      "description": "Centrifugo WebSocket endpoint from tenant.json. Current mobile client connects without a token; server allows anonymous subscriptions for these channels.",
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "x-client": {
        "library": "centrifuge",
        "connectTimeoutSeconds": 10,
        "minReconnectDelaySeconds": 1,
        "maxReconnectDelaySeconds": 30,
        "auth": "anonymous"
      },
      "x-alternateTransportsFromTenant": {
        "httpStream": "https://streaming.verolabs.co/connection/http_stream",
        "sse": "https://streaming.verolabs.co/connection/sse",
        "note": "Configured in tenant.json but not used by the current mobile StreamingService."
      }
    }
  },
  "defaultContentType": "application/json",
  "channels": {
    "mkt:{dataType}:{symbol}": {
      "description": "Generic market-data subscription used by subscribeMarketData(symbol, dataType). Specific helpers below use more precise channel formats for depth, OHLCV and product info.",
      "parameters": {
        "dataType": {
          "$ref": "#/components/parameters/dataType"
        },
        "symbol": {
          "$ref": "#/components/parameters/symbol"
        }
      },
      "subscribe": {
        "operationId": "receiveGenericMarketData",
        "summary": "Receive generic market data updates",
        "message": {
          "$ref": "#/components/messages/GenericMarketDataMessage"
        }
      }
    },
    "mkt:depth:{symbol}-{boardId}": {
      "description": "Order-book depth updates. Current app default boardId is G1.",
      "parameters": {
        "symbol": {
          "$ref": "#/components/parameters/symbol"
        },
        "boardId": {
          "$ref": "#/components/parameters/boardId"
        }
      },
      "subscribe": {
        "operationId": "receiveMarketDepth",
        "summary": "Receive bid/ask depth updates",
        "message": {
          "$ref": "#/components/messages/MarketDepthMessage"
        }
      }
    },
    "mkt:OhlcvDTO:{symbol}:{time}": {
      "description": "Candlestick/OHLCV updates. Current app default time is 60 seconds.",
      "parameters": {
        "symbol": {
          "$ref": "#/components/parameters/symbol"
        },
        "time": {
          "$ref": "#/components/parameters/time"
        }
      },
      "subscribe": {
        "operationId": "receiveOhlcv",
        "summary": "Receive OHLCV candle updates",
        "message": {
          "$ref": "#/components/messages/OhlcvMessage"
        }
      }
    },
    "mkt:productInfo:{symbol}-{boardId}": {
      "description": "Product info/quote updates. Current app default boardId is G1.",
      "parameters": {
        "symbol": {
          "$ref": "#/components/parameters/symbol"
        },
        "boardId": {
          "$ref": "#/components/parameters/boardId"
        }
      },
      "subscribe": {
        "operationId": "receiveProductInfo",
        "summary": "Receive product info updates",
        "message": {
          "$ref": "#/components/messages/ProductInfoMessage"
        }
      }
    },
    "order:{accountId}": {
      "description": "Realtime order updates for an account.",
      "parameters": {
        "accountId": {
          "$ref": "#/components/parameters/accountId"
        }
      },
      "subscribe": {
        "operationId": "receiveOrderUpdates",
        "summary": "Receive order updates",
        "message": {
          "$ref": "#/components/messages/OrderMessage"
        }
      }
    },
    "order:Account:{accountId}": {
      "description": "Realtime account/portfolio updates.",
      "parameters": {
        "accountId": {
          "$ref": "#/components/parameters/accountId"
        }
      },
      "subscribe": {
        "operationId": "receiveAccountUpdates",
        "summary": "Receive account updates",
        "message": {
          "$ref": "#/components/messages/AccountMessage"
        }
      }
    },
    "order:OrderExecutionReport:{connectionId}": {
      "description": "Realtime order execution reports for the active connection_id.",
      "parameters": {
        "connectionId": {
          "$ref": "#/components/parameters/connectionId"
        }
      },
      "subscribe": {
        "operationId": "receiveOrderExecutionReports",
        "summary": "Receive order execution reports",
        "message": {
          "$ref": "#/components/messages/OrderMessage"
        }
      }
    },
    "order:{notificationType}:{accountId}": {
      "description": "Trading/account notifications. The app subscribes to Deposit, ForceClose, MarginCall and Withdraw.",
      "parameters": {
        "notificationType": {
          "$ref": "#/components/parameters/notificationType"
        },
        "accountId": {
          "$ref": "#/components/parameters/accountId"
        }
      },
      "subscribe": {
        "operationId": "receiveNotifications",
        "summary": "Receive notification events",
        "message": {
          "$ref": "#/components/messages/NotificationMessage"
        }
      }
    }
  },
  "components": {
    "parameters": {
      "symbol": {
        "description": "Trading symbol, for example VN30F1M.",
        "schema": {
          "type": "string",
          "examples": [
            "VN30F1M"
          ]
        }
      },
      "boardId": {
        "description": "Trading board id. The mobile app defaults to G1.",
        "schema": {
          "type": "string",
          "default": "G1",
          "examples": [
            "G1"
          ]
        }
      },
      "time": {
        "description": "Candle resolution in seconds. The mobile app uses 60 for 1 minute and 86400 for daily.",
        "schema": {
          "type": "integer",
          "default": 60,
          "enum": [
            60,
            86400
          ]
        }
      },
      "dataType": {
        "description": "Market data type configured in ApiConfig.",
        "schema": {
          "type": "string",
          "enum": [
            "depth",
            "productInfo",
            "productStat",
            "tradeLog"
          ]
        }
      },
      "accountId": {
        "description": "Trading account id.",
        "schema": {
          "type": "string"
        }
      },
      "connectionId": {
        "description": "Centrifugo connection id for the active client connection.",
        "schema": {
          "type": "string"
        }
      },
      "notificationType": {
        "description": "Notification topic type supported by the mobile app.",
        "schema": {
          "type": "string",
          "enum": [
            "Deposit",
            "ForceClose",
            "MarginCall",
            "Withdraw"
          ]
        }
      }
    },
    "messages": {
      "GenericMarketDataMessage": {
        "name": "GenericMarketData",
        "title": "Generic market data publication",
        "summary": "Market data publication for productStat, tradeLog or other raw market-data topics.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/GenericObject"
        },
        "x-handler": "StreamingService._handleMarketData"
      },
      "MarketDepthMessage": {
        "name": "MarketDepth",
        "title": "Order-book depth publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/PriceDepth"
        },
        "x-handler": "StreamingService._handleDepthUpdate"
      },
      "OhlcvMessage": {
        "name": "Ohlcv",
        "title": "OHLCV candle publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/OhlcvBar"
        },
        "x-handler": "StreamingService._handleOhlcvUpdate"
      },
      "ProductInfoMessage": {
        "name": "ProductInfo",
        "title": "Product info publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/SymbolInfo"
        },
        "x-handler": "StreamingService._handleMarketData"
      },
      "OrderMessage": {
        "name": "Order",
        "title": "Order publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/Order"
        },
        "x-handler": "StreamingService._handleOrderUpdate"
      },
      "AccountMessage": {
        "name": "Account",
        "title": "Account publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/Account"
        },
        "x-handler": "StreamingService._handleAccountUpdate"
      },
      "NotificationMessage": {
        "name": "Notification",
        "title": "Notification publication",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/StreamingNotification"
        },
        "x-handler": "StreamingService._handleNotification"
      }
    },
    "schemas": {
      "GenericObject": {
        "type": "object",
        "additionalProperties": true
      },
      "OrderSide": {
        "type": "string",
        "enum": [
          "B",
          "S"
        ],
        "description": "B = Buy, S = Sell."
      },
      "OrderType": {
        "type": "string",
        "enum": [
          "LO",
          "MO",
          "ATO",
          "ATC",
          "MTL"
        ],
        "description": "LO = Limit, MO = Market, ATO = At The Open, ATC = At The Close, MTL = Market To Limit."
      },
      "OrderStatus": {
        "type": "string",
        "description": "The app handles FIX-style status codes and text aliases.",
        "enum": [
          "0",
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8",
          "pending",
          "new",
          "open",
          "partial_filled",
          "partially_filled",
          "filled",
          "complete",
          "completed",
          "cancelled",
          "canceled",
          "stopped",
          "stop",
          "rejected",
          "reject"
        ]
      },
      "Order": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "orderID": {
            "type": "string"
          },
          "order_id": {
            "type": "string",
            "description": "Snake_case alias accepted by the mobile parser."
          },
          "refOrderID": {
            "type": "string"
          },
          "ref_order_id": {
            "type": "string",
            "description": "Snake_case alias accepted by the mobile parser."
          },
          "externalOrderID": {
            "type": "string"
          },
          "externalSecondOrderID": {
            "type": "string"
          },
          "accountID": {
            "type": "string"
          },
          "account_id": {
            "type": "string",
            "description": "Snake_case alias accepted by the mobile parser."
          },
          "symbol": {
            "type": "string"
          },
          "orderSide": {
            "$ref": "#/components/schemas/OrderSide"
          },
          "order_side": {
            "$ref": "#/components/schemas/OrderSide"
          },
          "orderStatus": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "order_status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "orderType": {
            "$ref": "#/components/schemas/OrderType"
          },
          "order_type": {
            "$ref": "#/components/schemas/OrderType"
          },
          "orderEntryPrice": {
            "type": "number"
          },
          "order_entry_price": {
            "type": "number"
          },
          "orderEntryQty": {
            "type": "integer"
          },
          "order_entry_qty": {
            "type": "integer"
          },
          "orderCurrentPrice": {
            "type": "number"
          },
          "order_current_price": {
            "type": "number"
          },
          "orderCurrentQty": {
            "type": "integer"
          },
          "order_current_qty": {
            "type": "integer"
          },
          "filledQty": {
            "type": "integer"
          },
          "filled_qty": {
            "type": "integer"
          },
          "avgFillPrice": {
            "type": "number"
          },
          "avg_fill_price": {
            "type": "number"
          },
          "cancelledQty": {
            "type": "integer"
          },
          "cancelled_qty": {
            "type": "integer"
          },
          "orderText": {
            "type": "string"
          },
          "unixUTCTimeMs": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp in milliseconds."
          },
          "createunixUTCTimeMs": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp in milliseconds."
          },
          "persisState": {
            "type": "string"
          },
          "algoID": {
            "type": "string"
          },
          "positionID": {
            "type": "string"
          },
          "parentOrderId": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "totalEquity": {
            "type": "number"
          },
          "credit": {
            "type": "number"
          },
          "maintenanceMargin": {
            "type": "number"
          },
          "tempMaintenanceMargin": {
            "type": "number"
          },
          "totalRealizedPnl": {
            "type": "number"
          },
          "totalUnrealizedPnl": {
            "type": "number"
          },
          "tradingPower": {
            "type": "number"
          },
          "crossMargin": {
            "type": "boolean"
          },
          "refCode": {
            "type": "string"
          },
          "positions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Position"
            }
          },
          "tempPositions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TempPosition"
            }
          }
        }
      },
      "Position": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "avgPrice": {
            "type": "number"
          },
          "qty": {
            "type": "integer",
            "description": "Positive = long, negative = short."
          },
          "marketPrice": {
            "type": "number"
          },
          "marketValue": {
            "type": "number"
          },
          "portPercent": {
            "type": "number"
          },
          "realizePnl": {
            "type": "number"
          },
          "unrealizePnl": {
            "type": "number"
          },
          "coveredMarginCall": {
            "type": "number"
          },
          "marginRatio": {
            "$ref": "#/components/schemas/MarginRatio"
          },
          "forceClosePrice": {
            "type": "number"
          },
          "forceCloseStatus": {
            "type": "string"
          },
          "marginCallPrice": {
            "type": "number"
          },
          "marginCallStatus": {
            "type": "string"
          }
        }
      },
      "TempPosition": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "symbol": {
            "type": "string"
          },
          "netQty": {
            "type": "integer"
          },
          "avgPrice": {
            "type": "number"
          },
          "orderCount": {
            "type": "integer"
          },
          "marketPrice": {
            "type": "number"
          }
        }
      },
      "MarginRatio": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "marginRatio": {
            "type": "number"
          },
          "forceCloseRate": {
            "type": "number"
          },
          "marginCallRate": {
            "type": "number"
          },
          "tradingFee": {
            "type": "number"
          },
          "productCommission": {
            "type": "number"
          },
          "tax": {
            "type": "number"
          },
          "overnightFee": {
            "type": "number"
          }
        }
      },
      "PriceDepth": {
        "type": "object",
        "required": [
          "symbol"
        ],
        "additionalProperties": true,
        "properties": {
          "seq": {
            "type": "number"
          },
          "time": {
            "type": "number"
          },
          "symbol": {
            "type": "string"
          },
          "boardID": {
            "type": "string"
          },
          "bidPriceDepth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceLevel"
            }
          },
          "askPriceDepth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceLevel"
            }
          }
        }
      },
      "PriceLevel": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "prc": {
            "type": "number"
          },
          "vol": {
            "type": "number"
          }
        }
      },
      "OhlcvBar": {
        "type": "object",
        "required": [
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "additionalProperties": true,
        "properties": {
          "unixTime": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp. The mobile handler also accepts time."
          },
          "time": {
            "type": "integer",
            "format": "int64",
            "description": "Alias accepted by the mobile handler."
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          }
        }
      },
      "SymbolInfo": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "seq": {
            "type": "number"
          },
          "time": {
            "type": "number"
          },
          "symbol": {
            "type": "string"
          },
          "boardID": {
            "type": "string"
          },
          "currFR": {
            "type": "number"
          },
          "totalFR": {
            "type": "number"
          },
          "totBuyFR": {
            "type": "number"
          },
          "totSellFR": {
            "type": "number"
          },
          "nomiPrc": {
            "type": "number"
          },
          "ceilPrc": {
            "type": "number"
          },
          "floorPrc": {
            "type": "number"
          },
          "lsPrc": {
            "type": "number"
          },
          "lsVol": {
            "type": "number"
          },
          "AucEstPrc": {
            "type": "number"
          },
          "AucEstVol": {
            "type": "number"
          },
          "isAuction": {
            "type": "boolean"
          },
          "openPrc": {
            "type": "number"
          },
          "closePrc": {
            "type": "number"
          },
          "highPrc": {
            "type": "number"
          },
          "lowPrc": {
            "type": "number"
          },
          "vWAP": {
            "type": "number"
          },
          "totVol": {
            "type": "number"
          },
          "totVal": {
            "type": "number"
          },
          "totVolPT": {
            "type": "number"
          },
          "totValPT": {
            "type": "number"
          },
          "lsWay": {
            "type": "number"
          },
          "dynInfo": {
            "type": "string"
          },
          "marketMakingPossible": {
            "type": "string"
          },
          "halt": {
            "type": "string"
          },
          "liquidationTrading": {
            "type": "string"
          },
          "tradingSession": {
            "type": "string"
          },
          "boardEventID": {
            "type": "string"
          },
          "sessionOpenCloseCode": {
            "type": "string"
          },
          "openInterest": {
            "type": "number"
          }
        }
      },
      "NotificationType": {
        "type": "string",
        "enum": [
          "Deposit",
          "ForceClose",
          "MarginCall",
          "Withdraw"
        ]
      },
      "StreamingNotification": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "Type": {
            "$ref": "#/components/schemas/NotificationType"
          },
          "type": {
            "$ref": "#/components/schemas/NotificationType"
          },
          "accountId": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "amount": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": true
          },
          "account": {
            "type": "object",
            "additionalProperties": true
          },
          "MessageID": {
            "type": "string"
          },
          "messageID": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-source": {
    "tenantConfig": "tenant.json",
    "serviceFile": "lib/services/streaming_service.dart"
  }
}
